{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "znotes",
  "version": "0.1.0",
  "identifier": "com.techiesolo.znotes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "znotes",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 500,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "shortDescription": "Offline markdown notes, encrypted at rest",
    "longDescription": "znotes keeps markdown notes in a single SQLCipher-encrypted vault file. Nothing readable is written to disk."
  }
}
